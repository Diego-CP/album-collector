<html lang="en">
    <head>
        <link rel="stylesheet" href="/styles/styles.css" />
        <title>Album Collector</title>
    </head>
    <body>
        <span class="subpage-title">Group <%= groupName %></span>
        <br>
        <span class="subpage-title">Invite Code: <%= inviteCode %></span>
        <br>
        <span class="subtitle">Members</span>
        <ul>
        <% members.forEach(member => { %>
            <li><%= member.username %> (ID: <%= member.user_id %>)</li>
        <% }); %>
        </ul>
        <br>
        <span class="subtitle">Trades</span>
        <% if (calcStatus === 'failed') { %>
            <p>Error calculating trades.</p>
        <% } else if (trades.length === 0) { %>
            <p>No trades available.</p>
        <% } else if (calcStatus === 'processing') { %>
            <p>Trades are being calculated.</p>
        <% } else { %>
            <ul>
            <% trades.forEach(trade => { %>
                <li>
                    <ul>
                    <% trade.steps.forEach(step => { %>
                        <li>
                            <%= step.from_user %> gives <strong><%= step.sticker_name %> (<%= step.sticker_code %>)</strong> to <%= step.to_user %>
                        </li>
                    <% }); %>
                    </ul>
                </li>
            <% }); %>
            </ul>
        <% } %>
        <br>
        <button onclick="leaveGroup()">Leave Group</button>
        <script>
        async function leaveGroup() {
            fetch(`/api/groups/<%= groupId %>/leave`, { method: 'DELETE' })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                    return;
                }
                window.location.href = "/";
            })
            .catch(err => {
                console.error("Error:", err);
            });
        }
        </script>
    </body>
</html>