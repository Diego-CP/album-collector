<html lang="en">
    <head>
        <link rel="stylesheet" href="/styles/styles.css" />
        <title>Album Collector</title>
    </head>
    <body>
        <span class="subpage-title">Group <%= groupName %></span>
        <br>
        <span class="subpage-title">Invite Code: <%= inviteCode %></span>
        <br>
        <span class="subtitle">Members</span>
        <ul>
        <% members.forEach(member => { %>
            <li>
                <%= member.username %> (ID: <%= member.user_id %>, Role: <%= member.role %>)
                <% if (member.role !== 'admin') { %>
                    <button onclick="removeMember('<%= member.user_id %>')">Remove Member</button>
                <% } %>
            </li>
        <% }); %>
        </ul>
        <script>
        function removeMember(userId) {
            fetch(`/api/groups/<%= groupId %>/remove/${userId}`, { method: 'DELETE' })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                    return;
                }
                window.location.reload();
            })
            .catch(err => {
                console.error("Error:", err)
            });
        }
        </script>
        <br>
        <span class="subtitle">Trades</span>
        <br>
        <button onclick="deleteGroup()">Delete Group</button>
        <script>
        async function deleteGroup() {
            fetch(`/api/groups/<%= groupId %>/delete`, { method: 'DELETE' })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                    return;
                }
                window.location.href = "/";
            })
            .catch(err => {
                console.error("Error:", err);
            });
        }
        </script>
    </body>
</html>